// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  ADMIN
  MANAGER
  SELLER
  SUB_ACCOUNT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
  SUSPENDED
}

enum TransactionStatus {
  PENDING
  PROCESSING
  APPROVED
  DECLINED
  REFUNDED
  CANCELED
  CHARGEBACK
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  PIX
  BOLETO
  WALLET
  CRYPTO
}

enum Currency {
  BRL
  USD
  EUR
  GBP
  USDT
  BTC
  ETH
  SOL
  XMR
}

enum FeeType {
  FIXED
  PERCENTAGE
  COMBINED
}

enum WalletTransactionType {
  DEPOSIT
  WITHDRAW
  P2P_SEND
  P2P_RECEIVE
  PAYMENT
  REFUND
  FEE
  CHARGEBACK
}

enum KYCStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum AcquirerType {
  STRIPE
  PAYPAL
  ADYEN
  GERENCIANET
  CUSTOM
}

enum SSLStatus {
  PENDING
  ACTIVE
  EXPIRED
  INVALID
}

enum PixKeyType {
  CPF
  CNPJ
  EMAIL
  PHONE
  RANDOM_KEY
}

enum ConversionEventName {
  PAGE_VIEW
  ADD_TO_CART
  PURCHASE
  CHECKOUT_START
  CHECKOUT_COMPLETE
}

// ============================================
// MODELS
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String
  role          UserRole
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  refreshTokens RefreshToken[]
  manager       Manager?
  seller        Seller?
  subAccount    SubAccount?
  auditLogs     AuditLog[]
  walletTransactionsFrom WalletTransaction[] @relation("FromUser")
  walletTransactionsTo   WalletTransaction[] @relation("ToUser")

  @@index([email])
  @@index([role])
  @@index([status])
}

model RefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Manager {
  id        String    @id @default(cuid())
  userId    String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sellers   Seller[]

  @@index([userId])
}

model Seller {
  id                  String    @id @default(cuid())
  userId              String    @unique
  businessName        String
  document            String    @unique
  phone               String
  address             Json      // { street, number, city, state, zipCode, country }
  kycStatus           KYCStatus @default(PENDING)
  kycDocuments        Json?
  managerId           String?
  acquirerId          String
  feeConfigId         String
  retentionConfigId   String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  manager             Manager?          @relation(fields: [managerId], references: [id], onDelete: SetNull)
  acquirer            Acquirer          @relation(fields: [acquirerId], references: [id])
  feeConfig           FeeConfig         @relation(fields: [feeConfigId], references: [id])
  retentionConfig     RetentionConfig   @relation(fields: [retentionConfigId], references: [id])
  subAccounts         SubAccount[]
  transactions        Transaction[]
  splitTransactions   SplitTransaction[]
  wallet              Wallet?
  checkouts           Checkout[]
  customDomains       CustomDomain[]
  pixConfig           PixConfig?
  pixelConfigs        PixelConfig[]
  utmTracking         UTMTracking[]

  @@index([userId])
  @@index([document])
  @@index([managerId])
  @@index([acquirerId])
}

model SubAccount {
  id            String    @id @default(cuid())
  userId        String    @unique
  sellerId      String
  permissions   Json      // Array de permissões
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  seller        Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sellerId])
}

model Acquirer {
  id                    String    @id @default(cuid())
  name                  String
  type                  AcquirerType
  credentials           String    // JSON criptografado
  isActive              Boolean   @default(true)
  supportedMethods      Json      // Array de PaymentMethod
  supportedCurrencies   Json      // Array de Currency
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  sellers       Seller[]
  transactions  Transaction[]

  @@index([type])
  @@index([isActive])
}

model FeeConfig {
  id                  String    @id @default(cuid())
  cashInType          FeeType   @default(PERCENTAGE)
  cashInFixed         Decimal   @default(0) @db.Decimal(10, 2)
  cashInPercentage    Decimal   @default(0) @db.Decimal(5, 2)
  cashOutType         FeeType   @default(FIXED)
  cashOutFixed        Decimal   @default(0) @db.Decimal(10, 2)
  cashOutPercentage   Decimal   @default(0) @db.Decimal(5, 2)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sellers   Seller[]
}

model RetentionConfig {
  id                String    @id @default(cuid())
  retentionDays     Int       @default(14)
  retentionPercent  Decimal   @default(0) @db.Decimal(5, 2)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sellers   Seller[]
}

model Transaction {
  id                  String    @id @default(cuid())
  externalId          String    @unique
  sellerId            String
  acquirerId          String
  amount              Decimal   @db.Decimal(15, 2)
  currency            Currency  @default(BRL)
  feeAmount           Decimal   @db.Decimal(10, 2)
  netAmount           Decimal   @db.Decimal(15, 2)
  retainedAmount      Decimal   @db.Decimal(10, 2)
  releaseDate         DateTime?
  paymentMethod       PaymentMethod
  status              TransactionStatus @default(PENDING)
  customerEmail       String?
  customerName        String?
  customerDocument    String?
  metadata            Json?
  utmSource           String?
  utmMedium           String?
  utmCampaign         String?
  utmContent          String?
  utmTerm             String?
  checkoutId          String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  seller              Seller              @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  acquirer            Acquirer            @relation(fields: [acquirerId], references: [id])
  splitTransactions   SplitTransaction[]
  cryptoPayment       CryptoPayment?
  pixPayment          PixPayment?
  conversionEvents    ConversionEvent[]

  @@index([sellerId])
  @@index([acquirerId])
  @@index([externalId])
  @@index([status])
  @@index([currency])
  @@index([createdAt])
}

model SplitTransaction {
  id            String    @id @default(cuid())
  transactionId String
  recipientId   String
  amount        Decimal   @db.Decimal(15, 2)
  percentage    Decimal   @db.Decimal(5, 2)
  createdAt     DateTime  @default(now())

  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  recipient     Seller      @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([recipientId])
}

model Wallet {
  id              String    @id @default(cuid())
  sellerId        String    @unique
  balanceBRL      Decimal   @default(0) @db.Decimal(15, 2)
  balanceUSD      Decimal   @default(0) @db.Decimal(15, 2)
  balanceEUR      Decimal   @default(0) @db.Decimal(15, 2)
  balanceGBP      Decimal   @default(0) @db.Decimal(15, 2)
  balanceUSDT     Decimal   @default(0) @db.Decimal(18, 8)
  balanceBTC      Decimal   @default(0) @db.Decimal(18, 8)
  balanceETH      Decimal   @default(0) @db.Decimal(18, 8)
  balanceSOL      Decimal   @default(0) @db.Decimal(18, 8)
  balanceXMR      Decimal   @default(0) @db.Decimal(18, 8)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  seller          Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  transactions    WalletTransaction[]

  @@index([sellerId])
}

model WalletTransaction {
  id            String    @id @default(cuid())
  walletId      String
  type          WalletTransactionType
  amount        Decimal   @db.Decimal(18, 8)
  currency      Currency
  fromUserId    String?
  toUserId      String?
  txHash        String?
  address       String?
  status        String    @default("PENDING")
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  wallet        Wallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  fromUser      User?     @relation("FromUser", fields: [fromUserId], references: [id], onDelete: SetNull)
  toUser        User?     @relation("ToUser", fields: [toUserId], references: [id], onDelete: SetNull)

  @@index([walletId])
  @@index([type])
  @@index([currency])
  @@index([createdAt])
}

model CryptoPayment {
  id              String    @id @default(cuid())
  transactionId   String    @unique
  currency        Currency
  cryptoAmount    Decimal   @db.Decimal(18, 8)
  address         String
  txHash          String?
  confirmations   Int       @default(0)
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  transaction     Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([address])
}

model Checkout {
  id              String    @id @default(cuid())
  sellerId        String
  name            String
  templateId      String?
  config          Json?
  products        Json?
  enableUpsell    Boolean   @default(false)
  enableTimer     Boolean   @default(false)
  timerDuration   Int?
  metaTitle       String?
  metaDescription String?
  isActive        Boolean   @default(true)
  views           Int       @default(0)
  conversions     Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  seller          Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  customDomains   CustomDomain[]

  @@index([sellerId])
  @@index([isActive])
}

model CustomDomain {
  id              String    @id @default(cuid())
  sellerId        String
  checkoutId      String
  domain          String    @unique
  sslStatus       SSLStatus @default(PENDING)
  sslCertPath     String?
  sslKeyPath      String?
  isActive        Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  seller          Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  checkout        Checkout  @relation(fields: [checkoutId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@index([domain])
}

model PixConfig {
  id              String    @id @default(cuid())
  sellerId        String    @unique
  pixKey          String
  pixKeyType      PixKeyType
  webhookUrl      String?
  webhookSecret   String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  seller          Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
}

model PixPayment {
  id              String    @id @default(cuid())
  transactionId   String    @unique
  qrCode          String
  qrCodeBase64    String
  txId            String    @unique
  expiresAt       DateTime
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  transaction     Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([txId])
}

model PixelConfig {
  id              String    @id @default(cuid())
  sellerId        String
  platform        String    // facebook, google, tiktok, etc
  pixelId         String
  accessToken     String
  enablePageView  Boolean   @default(false)
  enableAddToCart Boolean   @default(false)
  enablePurchase  Boolean   @default(true)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  seller          Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([sellerId, platform])
  @@index([sellerId])
}

model ConversionEvent {
  id              String    @id @default(cuid())
  transactionId   String
  platform        String
  eventName       ConversionEventName
  eventId         String    @unique
  serverSent      Boolean   @default(false)
  clientSent      Boolean   @default(false)
  response        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  transaction     Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([platform])
}

model UTMTracking {
  id              String    @id @default(cuid())
  sellerId        String
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmContent      String?
  utmTerm         String?
  converted       Boolean   @default(false)
  transactionId   String?
  ip              String?
  userAgent       String?
  referrer        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  seller          Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@index([utmSource])
  @@index([utmCampaign])
  @@index([converted])
}

model WebhookLog {
  id              String    @id @default(cuid())
  url             String
  method          String    // GET, POST, PUT, DELETE
  headers         Json
  payload         Json?
  response        Json?
  statusCode      Int?
  attempts        Int       @default(1)
  success         Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([url])
  @@index([success])
  @@index([createdAt])
}

model AuditLog {
  id              String    @id @default(cuid())
  userId          String
  action          String
  entity          String
  entityId        String
  before          Json?
  after           Json?
  ip              String?
  userAgent       String?
  createdAt       DateTime  @default(now())

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
}
